# Copy this file to ".env" and fill in from:
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Must match the region of your Cloud Functions (default us-central1)
VITE_FUNCTIONS_REGION=us-central1

# Only used by "npm run simulate" (demo without hardware). Use the device account.
SIM_EMAIL=device@smartaquarium.local
SIM_PASSWORD=
